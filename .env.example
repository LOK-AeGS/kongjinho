# .env 로 복사해서 값을 넣으세요: cp .env.example .env
# .env 는 .gitignore 로 제외되어 GitHub 에 올라가지 않습니다. 이 파일에는 실제 키를 넣지 마세요.
OPENAI_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kv-cache-supervisor
# 기본 judge는 gpt-4.1: v2 실험에서 탐지율·일관성·지연·비용 균형이 가장 좋았음
QUALITY_JUDGE_MODEL=
# Supervisor LLM 모드의 기본 모델. reasoning fidelity를 위해 비우면 gpt-4.1
SUPERVISOR_MODEL=
# 원문 검증형 stakeholder 검색·추출 모델. 비우면 gpt-5-mini
STAKEHOLDER_MODEL=
